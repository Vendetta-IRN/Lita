<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Lita.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/lita_black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_lita_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Lita</item>
        <item name="android:windowBackground">@color/lita_black</item>
    </style>

    <style name="Theme.Lita" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/lita_black</item>
        <item name="android:colorBackground">@color/lita_black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
